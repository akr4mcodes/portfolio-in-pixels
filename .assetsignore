# Cloudflare Workers Static Assets ignore file
# Exclude dependencies and build outputs
node_modules
node_modules/**
.wrangler
.wrangler/**
dist
dist/**
build
build/**

# Exclude repository files
.git
.git/**
.github
.github/**

# Exclude configs and documentation
package.json
package-lock.json
wrangler.jsonc
wrangler.json
wrangler.toml
README.md
LICENSE

# Exclude ignore files
.gitignore
.assetsignore
.pagesignore

# Exclude OS files
.DS_Store
Thumbs.db
